# Configuración de Firebase (proyecto cliente, SDK modular)
# Copiá este archivo a ".env" y completá los valores reales desde
# Firebase Console > Configuración del proyecto > Tus apps > SDK setup and configuration.
#
# Estas variables son públicas por naturaleza (viajan al navegador con el prefijo VITE_),
# la seguridad de Firestore se controla con las reglas de seguridad (firestore.rules),
# no ocultando estos valores.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
